+
+/**********************************************************************
+ *          WAYLAND_SystrayClickPos
+ *
+ * Where a click on the desktop's tray (StatusNotifierItem's Activate, in the compositor's
+ * logical coordinates) is in Wine's: Wine does not know where the pointer is out of its
+ * windows, programs open their menu at the cursor. The other way from wayland_output_at.
+ */
+BOOL WAYLAND_SystrayClickPos(POINT *pt)
+{
+    struct wayland_output *output, *primary = NULL;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    wl_list_for_each(output, &process_wayland.output_list, link)
+    {
+        struct wayland_output_state *state = &output->current;
+        int width, height, logical_w, logical_h;
+
+        if (!state->current_mode) continue;
+        if (!primary) primary = output;
+        width = wayland_output_mode_width(state, state->current_mode);
+        height = wayland_output_mode_height(state, state->current_mode);
+        logical_w = state->logical_w > 0 ? state->logical_w : width;
+        logical_h = state->logical_h > 0 ? state->logical_h : height;
+        if (pt->x < state->logical_x || pt->y < state->logical_y ||
+            pt->x >= state->logical_x + logical_w || pt->y >= state->logical_y + logical_h)
+            continue;
+        pt->x = state->logical_x - primary->current.logical_x + (pt->x - state->logical_x) * width / logical_w;
+        pt->y = state->logical_y - primary->current.logical_y + (pt->y - state->logical_y) * height / logical_h;
+        break;
+    }
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+    return TRUE;
+}
