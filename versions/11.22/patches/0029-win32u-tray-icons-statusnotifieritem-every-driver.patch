+/***********************************************************************
+ *              SystrayClickPos   (X11DRV.@)
+ *
+ * The desktop's tray was clicked at a point of the root window. The X pointer is there already
+ * on an X server; Xwayland does not know where the pointer is out of its windows, and the warp
+ * puts it there for the programs that read it.
+ */
+BOOL X11DRV_SystrayClickPos( POINT *pt )
+{
+    *pt = root_to_virtual_screen( pt->x, pt->y );
+    return TRUE;
+}
