From: Wine Fox
Subject: [PATCH] win32u, winewayland: Client surfaces cropped to the window region, with its opacity, without a stale frame.

* winewayland: Crop the client surface to the window region.

Unreal Engine's tooltips are windows of at least 512x256 cut to their text by a window region,
and drawn through Vulkan. Under Wayland the client surface covered the whole client area
whatever the region, so the tooltips showed a black rectangle around their text.

Wayland cannot shape a surface, but the viewport can crop it: to the bounding box of the region.
The viewport source must lie inside the attached buffer or the compositor disconnects the client,
so it is computed in the size of the buffers presented now, which win32u records for Vulkan
swapchains (their host extents) and the driver for OpenGL (the wl_egl_window size), and only
when that size is known. X11 (patch 0003) applies the exact shape instead.

* winewayland: Apply the opacity of layered windows to their client surface.

Unreal Engine shows its menus and tooltips as layered windows of opacity 0 and fades them in.
The opacity reached the window's own surface (alpha modifier), but not the client surface that
Vulkan or OpenGL draws to, so what they drew showed at once and at full opacity: a white or
black flash before their first frame, and no fade.

The client surface gets an alpha modifier too, set from the layered attributes of its toplevel
when it is updated and when they change; it applies with the next frame the client presents.
Needs a compositor with wp_alpha_modifier_v1 (KWin, Mutter), like the window's own opacity.

* winewayland: Clear the frame of a client surface when its window is hidden.

A client surface is detached from its window when the window is hidden, and kept its last frame:
shown again, the window showed it at once, stretched to its new size, until the next frame.
Unreal Engine reuses its tooltip window, and its big tooltips (Content Browser) flashed the
previous one. The surface gets no buffer when detached, and shows nothing until it presents.

diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 3265d74..f8aedfc 100755
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -155,6 +155,7 @@ struct swapchain
     struct vulkan_swapchain obj;
     struct surface *surface;
     VkExtent2D extents;
+    VkExtent2D host_extents; /* the size of its buffers on the host */
 };
 
 static struct swapchain *swapchain_from_handle( VkSwapchainKHR handle )
@@ -1931,6 +1932,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     vulkan_object_init( &swapchain->obj.obj, host_swapchain );
     swapchain->surface = surface;
     swapchain->extents = create_info->imageExtent;
+    swapchain->host_extents = create_info_host.imageExtent;
     instance->p_insert_object( instance, &swapchain->obj.obj );
 
     *ret = swapchain->obj.client.swapchain;
@@ -2042,6 +2044,9 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
     {
         struct swapchain *swapchain = swapchain_from_handle( client_swapchains[i] );
         struct surface *surface = swapchain->surface;
+        /* the size of the buffer this present attaches, for drivers that crop it */
+        __atomic_store_n( &surface->client->buffer_size, ((LONG64)swapchain->host_extents.width << 32) |
+                      swapchain->host_extents.height, __ATOMIC_RELEASE );
         client_surface_update( surface->client );
     }
 
diff --git a/dlls/winewayland.drv/opengl.c b/dlls/winewayland.drv/opengl.c
index fb45cf1..e0d2105 100755
--- a/dlls/winewayland.drv/opengl.c
+++ b/dlls/winewayland.drv/opengl.c
@@ -105,6 +105,7 @@ static BOOL wayland_opengl_surface_create(struct client_surface *client, int for
     if (gl->base.stereo) opengl_drawable_map_buffer(&gl->base, GL_FRONT_RIGHT, GL_BACK_RIGHT);
 
     if (!(gl->wl_egl_window = wl_egl_window_create(surface->wl_surface, size.cx, size.cy))) goto err;
+    __atomic_store_n(&gl->base.client->buffer_size, ((LONG64)size.cx << 32) | size.cy, __ATOMIC_RELEASE);
     if (!(gl->base.surface = funcs->p_eglCreateWindowSurface(egl->display, config, gl->wl_egl_window, attribs))) goto err;
     set_client_surface(hwnd, surface);
 
@@ -137,7 +138,12 @@ static void wayland_drawable_flush(struct opengl_drawable *base, UINT flags)
 
     /* Since context_flush is called from operations that may latch the native size,
      * perform any pending resizes before calling them. */
-    if (flags & GL_FLUSH_UPDATED) wl_egl_window_resize(gl->wl_egl_window, size.cx, size.cy, 0, 0);
+    if (flags & GL_FLUSH_UPDATED)
+    {
+        wl_egl_window_resize(gl->wl_egl_window, size.cx, size.cy, 0, 0);
+        /* the size of the buffers from the next swap on, for the crop to the window region */
+        if (gl->base.client) __atomic_store_n(&gl->base.client->buffer_size, ((LONG64)size.cx << 32) | size.cy, __ATOMIC_RELEASE);
+    }
 }
 
 static BOOL wayland_drawable_swap(struct opengl_drawable *base)
diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 19c6aa4..e715840 100755
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -774,6 +774,60 @@ static void wayland_surface_reconfigure_size(struct wayland_surface *surface,
         wp_viewport_set_destination(surface->wp_viewport, -1, -1);
 }
 
+/* Crops the client surface to client->crop: sets the viewport source, in the pixels of the
+ * buffers presented now, and narrows rect (the client area in surface coordinates) to the part
+ * shown. FALSE when there is nothing to crop or the buffer size is not known. */
+static BOOL client_crop_rect(struct wayland_client_surface *client, RECT *rect)
+{
+    LONG64 size = __atomic_load_n(&client->client.buffer_size, __ATOMIC_ACQUIRE);
+    LONG bw = (LONG)(size >> 32), bh = (LONG)(size & 0xffffffff);
+    LONG vw = client->client.virtual_rect.right - client->client.virtual_rect.left;
+    LONG vh = client->client.virtual_rect.bottom - client->client.virtual_rect.top;
+    LONG dw = rect->right - rect->left, dh = rect->bottom - rect->top;
+    RECT crop = client->crop, src;
+
+    if (!client->cropped || bw <= 0 || bh <= 0 || vw <= 0 || vh <= 0) return FALSE;
+
+    /* to buffer pixels, inside the buffer whatever the window did meanwhile */
+    src.left = min(max((LONG64)crop.left * bw / vw, 0), bw - 1);
+    src.top = min(max((LONG64)crop.top * bh / vh, 0), bh - 1);
+    src.right = min(max((LONG64)crop.right * bw / vw, src.left + 1), bw);
+    src.bottom = min(max((LONG64)crop.bottom * bh / vh, src.top + 1), bh);
+    if (src.left == 0 && src.top == 0 && src.right == bw && src.bottom == bh) return FALSE;
+
+    wp_viewport_set_source(client->wp_viewport, wl_fixed_from_int(src.left), wl_fixed_from_int(src.top),
+                           wl_fixed_from_int(src.right - src.left), wl_fixed_from_int(src.bottom - src.top));
+
+    /* the same part of the area the whole buffer would cover */
+    SetRect(rect, rect->left + (LONG64)src.left * dw / bw, rect->top + (LONG64)src.top * dh / bh,
+            rect->left + (LONG64)src.right * dw / bw, rect->top + (LONG64)src.bottom * dh / bh);
+    return TRUE;
+}
+
+/* The part of the client area its toplevel's window region leaves visible (client->crop). */
+static void client_update_crop(struct wayland_client_surface *client, HWND toplevel)
+{
+    const RECT *virt = &client->client.virtual_rect;
+    HRGN hrgn = NtGdiCreateRectRgn(0, 0, 0, 0);
+    RECT box, crop;
+    BOOL cropped = FALSE;
+
+    if (hrgn && NtUserGetWindowRgnEx(toplevel, hrgn, 0) != ERROR && NtGdiGetRgnBox(hrgn, &box) != ERROR)
+    {
+        crop.left = max(box.left, virt->left) - virt->left;
+        crop.top = max(box.top, virt->top) - virt->top;
+        crop.right = min(box.right, virt->right) - virt->left;
+        crop.bottom = min(box.bottom, virt->bottom) - virt->top;
+        /* nothing to crop when the region covers the client area or leaves none of it */
+        cropped = crop.left < crop.right && crop.top < crop.bottom &&
+                  (crop.left > 0 || crop.top > 0 || crop.right < virt->right - virt->left ||
+                   crop.bottom < virt->bottom - virt->top);
+        if (cropped) client->crop = crop;
+    }
+    if (hrgn) NtGdiDeleteObjectApp(hrgn);
+    client->cropped = cropped;
+}
+
 /**********************************************************************
  *          wayland_surface_reconfigure_client
  *
@@ -790,6 +844,16 @@ static void wayland_surface_reconfigure_client(struct wayland_surface *surface,
 
     TRACE("hwnd=%p rect=%s\n", surface->hwnd, wine_dbgstr_rect(&rect));
 
+    /* The window region (tooltips of Unreal Engine are 512x256 windows cut to their text by a
+     * region): Wayland cannot shape a surface, but the viewport can crop it to the part the region
+     * leaves. The source must lie inside the attached buffer, or the compositor disconnects us:
+     * it is computed in the size of the buffers presented now, and only when that is known. */
+    if (client_crop_rect(client, &rect))
+        TRACE("hwnd=%p cropped to the window region: %s\n", surface->hwnd, wine_dbgstr_rect(&rect));
+    else
+        wp_viewport_set_source(client->wp_viewport, wl_fixed_from_int(-1), wl_fixed_from_int(-1),
+                               wl_fixed_from_int(-1), wl_fixed_from_int(-1));
+
     if (client->wl_subsurface)
     {
         wl_subsurface_set_position(client->wl_subsurface, rect.left, rect.top);
@@ -801,6 +865,9 @@ static void wayland_surface_reconfigure_client(struct wayland_surface *surface,
     else /* We can't have a 0x0 destination, use 1x1 instead. */
         wp_viewport_set_destination(client->wp_viewport, 1, 1);
 
+    if (client->wp_alpha_modifier_surface_v1)
+        wp_alpha_modifier_surface_v1_set_multiplier(client->wp_alpha_modifier_surface_v1, client->opacity);
+
     client->rect = *client_rect;
 }
 
@@ -1252,6 +1319,8 @@ static void wayland_client_surface_destroy(struct client_surface *client)
 
     if (surface->color_management)
         wp_color_management_surface_v1_destroy(surface->color_management);
+    if (surface->wp_alpha_modifier_surface_v1)
+        wp_alpha_modifier_surface_v1_destroy(surface->wp_alpha_modifier_surface_v1);
     if (surface->wp_viewport)
         wp_viewport_destroy(surface->wp_viewport);
     if (surface->wl_subsurface)
@@ -1283,6 +1352,20 @@ static void wayland_client_surface_update(struct client_surface *client)
 
     if (toplevel) visible = NtUserIsWindowVisible(hwnd);
 
+    /* read here, outside the driver locks: the region query goes to the server */
+    if (toplevel && visible)
+    {
+        COLORREF key;
+        BYTE alpha;
+        DWORD flags = 0;
+
+        client_update_crop(surface, toplevel);
+        if (!(NtUserGetWindowLongW(toplevel, GWL_EXSTYLE) & WS_EX_LAYERED) ||
+            !NtUserGetLayeredWindowAttributes(toplevel, &key, &alpha, &flags))
+            flags = 0;
+        surface->opacity = (flags & LWA_ALPHA) ? (UINT32_MAX / 0xff) * alpha : UINT32_MAX;
+    }
+
     if (toplevel && visible)
         wayland_client_surface_attach(surface, toplevel, &client->monitor_rect);
     else
@@ -1407,6 +1490,12 @@ struct client_surface *WAYLAND_CreateClientSurface(HWND hwnd, int pixel_format,
         goto err;
     }
 
+    /* the opacity of a layered window applies to what it draws through Vulkan or OpenGL too */
+    client->opacity = UINT32_MAX;
+    if (process_wayland.wp_alpha_modifier_v1)
+        client->wp_alpha_modifier_surface_v1 =
+            wp_alpha_modifier_v1_get_surface(process_wayland.wp_alpha_modifier_v1, client->wl_surface);
+
     return &client->client;
 
 err:
@@ -1425,6 +1514,12 @@ void wayland_client_surface_attach(struct wayland_client_surface *client, HWND t
         {
             wl_subsurface_destroy(client->wl_subsurface);
             client->wl_subsurface = NULL;
+            /* The surface keeps its last frame, and showed it at once when the window was shown
+             * again, stretched to its new size, before the frame of its new contents: Unreal
+             * Engine reuses its tooltip window, and big tooltips (Content Browser) flashed the
+             * previous one. Nothing until the next frame instead. */
+            wl_surface_attach(client->wl_surface, NULL, 0, 0);
+            wl_surface_commit(client->wl_surface);
         }
 
         client->toplevel = 0;
@@ -1622,6 +1717,16 @@ void wayland_surface_assign_icon(struct wayland_surface *surface)
     }
 }
 
+/* Unreal Engine shows its menus and tooltips fully transparent and fades them in: without this,
+ * what they draw through Vulkan showed at once, white or black before their first frame. Applied
+ * with the next frame the client presents. */
+void wayland_client_surface_set_opacity(struct wayland_client_surface *client, BYTE alpha, UINT flags)
+{
+    client->opacity = (flags & LWA_ALPHA) ? (UINT32_MAX / 0xff) * alpha : UINT32_MAX;
+    if (client->wp_alpha_modifier_surface_v1)
+        wp_alpha_modifier_surface_v1_set_multiplier(client->wp_alpha_modifier_surface_v1, client->opacity);
+}
+
 void wayland_surface_set_opacity(struct wayland_surface *surface, BYTE alpha, UINT flags)
 {
     if (surface->wp_alpha_modifier_surface_v1)
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 21dd9ae..9ee1ad3 100755
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -259,6 +259,10 @@ struct wayland_client_surface
     struct wl_subsurface *wl_subsurface;
     struct wp_viewport *wp_viewport;
     struct wp_color_management_surface_v1 *color_management;
+    RECT crop;    /* the part the window region leaves visible, in virtual coordinates from the client origin */
+    BOOL cropped; /* crop is set */
+    struct wp_alpha_modifier_surface_v1 *wp_alpha_modifier_surface_v1;
+    UINT32 opacity; /* the alpha multiplier of its toplevel, a layered window */
 };
 
 extern struct wayland_client_surface *impl_from_client_surface(struct client_surface *client);
@@ -353,6 +357,7 @@ void wayland_surface_set_title(struct wayland_surface *surface, LPCWSTR title);
 void wayland_surface_assign_icon(struct wayland_surface *surface);
 void wayland_surface_set_icon_buffer(struct wayland_surface *surface, UINT type, const ICONINFO *ii);
 void wayland_surface_set_opacity(struct wayland_surface *surface, BYTE alpha, UINT flags);
+void wayland_client_surface_set_opacity(struct wayland_client_surface *client, BYTE alpha, UINT flags);
 
 static inline BOOL wayland_surface_is_toplevel(struct wayland_surface *surface)
 {
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 270fdfb..ddde1ed 100755
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -652,6 +652,8 @@ void WAYLAND_SetLayeredWindowAttributes(HWND hwnd, COLORREF key, BYTE alpha, DWO
 
     if ((surface = data->wayland_surface))
         wayland_surface_set_opacity(surface, alpha, flags);
+    if (data->client_surface)
+        wayland_client_surface_set_opacity(data->client_surface, alpha, flags);
     data->layered_attribs_set = TRUE;
 
     wayland_win_data_release(data);
diff --git a/include/wine/gdi_driver.h b/include/wine/gdi_driver.h
index 1b431fe..a66b7aa 100755
--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -280,6 +280,7 @@ struct client_surface
     RECT                               virtual_rect;   /* virtual size and position in the toplevel ancestor, relative to its visible rect */
     RECT                               monitor_rect;   /* raw physical size and position in the toplevel ancestor, relative to its visible rect */
     BOOL                               raw;            /* use the raw physical position and size for the host client surface */
+    LONG64                             buffer_size;    /* width << 32 | height of the buffers presented now, 0 if not known */
 };
 
 W32KAPI void *client_surface_create( const struct client_surface_funcs *funcs, HWND hwnd, int format, BOOL raw );
