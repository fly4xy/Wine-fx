+        WCHAR class[64];
+        UNICODE_STRING name = {.Buffer = class, .MaximumLength = sizeof(class)};
+        if (!NtUserGetClassName(data->hwnd, FALSE, &name)) class[0] = 0;
+        TRACE_(systray)("hwnd=%p class %s style %#x exstyle %#x owner %p (role %d) managed %d -> role %d\n",
+                        data->hwnd, debugstr_w(class), (int)NtUserGetWindowLongW(data->hwnd, GWL_STYLE),
+                        (int)exstyle, NtUserGetWindowRelative(data->hwnd, GW_OWNER),
