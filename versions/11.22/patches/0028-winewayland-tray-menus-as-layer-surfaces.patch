+static BOOL is_popup(HWND hwnd, struct wayland_surface *owner_surface, BOOL *input)
+{
+    *input = FALSE;
+    if (!owner_surface || !wayland_surface_is_toplevel(owner_surface) || !owner_surface->xdg_surface) return FALSE;
+    if (xdg_wm_base_get_version(process_wayland.xdg_wm_base) < 3) return FALSE;
+    return is_popup_window(hwnd, FALSE, input);
+}
+
+/* a popup at the cursor, the pointer on no window of ours: a tray icon's menu (programs open it
+ * at the cursor, which explorer puts where the tray was clicked) */
+static BOOL is_at_outer_cursor(const RECT *rect)
+{
+    RECT near = *rect;
+    POINT pt;
+
+    if (wayland_pointer_get_focused_toplevel() || !NtUserGetCursorPos(&pt)) return FALSE;
+    InflateRect(&near, 2, 2);
+    return PtInRect(&near, pt);
+}
+
+/* The same windows, and Qt's menus, when they have no shown window of ours to be xdg_popups of:
+ * a tray icon's menu, its window hidden in the tray (Battle.net), was a subsurface of that hidden
+ * window (not shown at all) or a window in the middle of the screen (Qt's). Their owner is hidden
+ * or a layer surface itself (a submenu), or they have none. Also those opened at the cursor while
+ * the pointer is on no window of ours (a tray icon's menu, its window shown): placed from where
+ * Wine has the owner, they were not where the compositor shows it, nor at the icon. */
+static BOOL is_layer(struct wayland_win_data *data, struct wayland_surface *owner_surface, BOOL *input)
+{
+    struct wayland_surface *surface = data->wayland_surface;
+
+    *input = FALSE;
+    if (!process_wayland.zwlr_layer_shell_v1 || data->managed) return FALSE;
+    if ((NtUserGetWindowLongW(data->hwnd, GWL_STYLE) & (WS_POPUP | WS_CHILD)) != WS_POPUP) return FALSE;
+    if (!is_popup_window(data->hwnd, TRUE, input)) return FALSE;
+    if (surface && surface->layer_surface) return TRUE;
+    if (!owner_surface || owner_surface->role == WAYLAND_SURFACE_ROLE_LAYER ||
+        owner_surface->role == WAYLAND_SURFACE_ROLE_NONE ||
+        (owner_surface->role == WAYLAND_SURFACE_ROLE_TOPLEVEL && !owner_surface->xdg_toplevel))
+        return TRUE;
+    /* a popup of a shown window keeps the role it has while it is shown */
+    if (surface && (surface->xdg_popup || surface->wl_subsurface || surface->xdg_toplevel)) return FALSE;
+    return is_at_outer_cursor(&data->rects.window);
+}
