diff --git a/dlls/winewayland.drv/wayland_keyboard.c b/dlls/winewayland.drv/wayland_keyboard.c
index ba2cc48..dc68233 100644
--- a/dlls/winewayland.drv/wayland_keyboard.c
+++ b/dlls/winewayland.drv/wayland_keyboard.c
@@ -860,11 +860,30 @@ void wayland_keyboard_deactivate(HWND hwnd)
 {
     struct wayland_keyboard *keyboard = &process_wayland.keyboard;
     HWND focused, foreground = NtUserGetForegroundWindow();
+    struct wayland_win_data *data;
+    BOOL layer = FALSE;
 
     pthread_mutex_lock(&keyboard->mutex);
     focused = keyboard->focused_hwnd;
     pthread_mutex_unlock(&keyboard->mutex);
 
+    if (!focused && (data = wayland_win_data_get(hwnd)))
+    {
+        layer = data->wayland_surface && data->wayland_surface->role == WAYLAND_SURFACE_ROLE_LAYER;
+        wayland_win_data_release(data);
+    }
+    /* A menu on a layer surface (a tray icon's) does not see the clicks out of it that close a
+     * menu: another application taking the keyboard closes it, as a click there would (Wine's
+     * menus end on WM_CANCELMODE, Qt's on losing the capture or the activation). */
+    if (layer)
+    {
+        TRACE("popup %p lost the keyboard to another application\n", hwnd);
+        NtUserReleaseCapture();
+        NtUserPostMessage(hwnd, WM_CANCELMODE, 0, 0);
+        if (foreground) NtUserSetForegroundWindow(NtUserGetDesktopWindow());
+        return;
+    }
+
     if (focused || !foreground || NtUserGetAncestor(foreground, GA_ROOT) != NtUserGetAncestor(hwnd, GA_ROOT)) return;
     TRACE("hwnd %p lost the keyboard to another application\n", hwnd);
     NtUserSetForegroundWindow(NtUserGetDesktopWindow());
diff --git a/dlls/winewayland.drv/wayland_output.c b/dlls/winewayland.drv/wayland_output.c
index 79dd6dc..6664a3f 100644
--- a/dlls/winewayland.drv/wayland_output.c
+++ b/dlls/winewayland.drv/wayland_output.c
@@ -399,3 +399,41 @@ void wayland_output_use_xdg_extension(struct wayland_output *output)
     zxdg_output_v1_add_listener(output->zxdg_output_v1, &zxdg_output_v1_listener,
                                 output);
 }
+
+/**********************************************************************
+ *          wayland_output_at
+ *
+ * The output at a point of Wine's virtual screen, and the point on it in the output's logical
+ * coordinates. The outputs are where UpdateDisplayDevices puts them: at their logical positions,
+ * from the first one.
+ * shortcut: the overlaps UpdateDisplayDevices resolves (fractional scales side by side) are not,
+ * a layer surface can be off on such setups; share its arrangement if they turn up.
+ */
+struct wl_output *wayland_output_at(int x, int y, POINT *pos)
+{
+    struct wayland_output *output, *primary = NULL, *found = NULL;
+    struct wl_output *ret = NULL;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    wl_list_for_each(output, &process_wayland.output_list, link)
+    {
+        struct wayland_output_state *state = &output->current;
+        int left, top, width, height;
+
+        if (!state->current_mode) continue;
+        if (!primary) primary = output;
+        left = state->logical_x - primary->current.logical_x;
+        top = state->logical_y - primary->current.logical_y;
+        width = wayland_output_mode_width(state, state->current_mode);
+        height = wayland_output_mode_height(state, state->current_mode);
+        if (x < left || y < top || x >= left + width || y >= top + height) continue;
+        pos->x = state->logical_w > 0 ? (x - left) * state->logical_w / width : x - left;
+        pos->y = state->logical_h > 0 ? (y - top) * state->logical_h / height : y - top;
+        found = output;
+        break;
+    }
+    if (!found && (found = primary)) pos->x = pos->y = 0;
+    if (found) ret = found->wl_output;
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+    return ret;
+}
diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 40ac52b..06ce6f1 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -675,6 +675,116 @@ void wayland_surface_make_popup(struct wayland_surface *surface,
     wl_display_flush(process_wayland.wl_display);
 }
 
+static void layer_surface_handle_configure(void *private, struct zwlr_layer_surface_v1 *layer_surface,
+                                           uint32_t serial, uint32_t width, uint32_t height)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    BOOL initial = FALSE;
+    HWND hwnd = private;
+
+    TRACE("hwnd=%p serial=%u %ux%u\n", hwnd, serial, width, height);
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if ((surface = data->wayland_surface) && surface->layer_surface == layer_surface)
+    {
+        zwlr_layer_surface_v1_ack_configure(layer_surface, serial);
+        initial = !surface->layer_configured;
+        surface->layer_configured = TRUE;
+        if (!initial) wl_surface_commit(surface->wl_surface);
+    }
+    wayland_win_data_release(data);
+
+    /* the contents could not be shown before the first configure */
+    if (initial) NtUserExposeWindowSurface(hwnd, 0, NULL);
+}
+
+static void layer_surface_handle_closed(void *private, struct zwlr_layer_surface_v1 *layer_surface)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    HWND hwnd = private;
+
+    TRACE("hwnd=%p\n", hwnd);
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if ((surface = data->wayland_surface) && surface->layer_surface == layer_surface)
+        wayland_surface_clear_role(surface);
+    wayland_win_data_release(data);
+}
+
+static const struct zwlr_layer_surface_v1_listener layer_surface_listener =
+{
+    layer_surface_handle_configure,
+    layer_surface_handle_closed,
+};
+
+/* where the window is on its output: margins from the output's top left, and its size */
+static struct wl_output *layer_surface_place(struct wayland_surface *surface, RECT *place)
+{
+    RECT rect = map_rect_to_surface(surface, surface->window.rect);
+    struct wl_output *output;
+    POINT pos;
+
+    output = wayland_output_at(surface->window.rect.left, surface->window.rect.top, &pos);
+    SetRect(place, pos.x, pos.y, pos.x + max(1, rect.right - rect.left), pos.y + max(1, rect.bottom - rect.top));
+    return output;
+}
+
+/**********************************************************************
+ *          wayland_surface_make_layer
+ *
+ * Gives the wayland surface the role of a layer surface on the overlay layer, at the window's
+ * place: the menus and popups that have no window of ours to be xdg_popups of (a tray icon's menu,
+ * its window hidden in the tray), which the compositor would show as windows in the middle of the
+ * screen.
+ */
+void wayland_surface_make_layer(struct wayland_surface *surface)
+{
+    struct wl_output *output;
+    RECT place;
+
+    assert(!surface->role || surface->role == WAYLAND_SURFACE_ROLE_LAYER);
+    if (surface->layer_surface) return;
+
+    wayland_surface_clear_role(surface);
+    surface->role = WAYLAND_SURFACE_ROLE_LAYER;
+
+    output = layer_surface_place(surface, &place);
+    TRACE("surface=%p at %s of output %p\n", surface, wine_dbgstr_rect(&place), output);
+    surface->layer_surface = zwlr_layer_shell_v1_get_layer_surface(process_wayland.zwlr_layer_shell_v1,
+            surface->wl_surface, output, ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY, "wine");
+    zwlr_layer_surface_v1_add_listener(surface->layer_surface, &layer_surface_listener, surface->hwnd);
+    zwlr_layer_surface_v1_set_anchor(surface->layer_surface, ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
+                                     ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT);
+    /* from the output's edges, not moved off panels */
+    zwlr_layer_surface_v1_set_exclusive_zone(surface->layer_surface, -1);
+    /* keys once clicked, and losing them when another window is clicked closes a menu */
+    if (zwlr_layer_shell_v1_get_version(process_wayland.zwlr_layer_shell_v1) >= 4)
+        zwlr_layer_surface_v1_set_keyboard_interactivity(surface->layer_surface,
+                ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_ON_DEMAND);
+    zwlr_layer_surface_v1_set_margin(surface->layer_surface, place.top, 0, 0, place.left);
+    zwlr_layer_surface_v1_set_size(surface->layer_surface, place.right - place.left, place.bottom - place.top);
+    surface->layer_place = place;
+
+    wayland_surface_init_fractional_scale(surface, 1.0);
+    wl_surface_commit(surface->wl_surface);
+    wl_display_flush(process_wayland.wl_display);
+}
+
+/* A layer surface whose window moved or changed size goes there: TRUE if it was asked to. */
+BOOL wayland_surface_reconfigure_layer(struct wayland_surface *surface)
+{
+    RECT place;
+
+    layer_surface_place(surface, &place);
+    if (EqualRect(&place, &surface->layer_place)) return FALSE;
+    TRACE("hwnd=%p %s\n", surface->hwnd, wine_dbgstr_rect(&place));
+    zwlr_layer_surface_v1_set_margin(surface->layer_surface, place.top, 0, 0, place.left);
+    zwlr_layer_surface_v1_set_size(surface->layer_surface, place.right - place.left, place.bottom - place.top);
+    surface->layer_place = place;
+    return TRUE;
+}
+
 /**********************************************************************
  *          wayland_surface_clear_role
  *
@@ -757,6 +867,15 @@ void wayland_surface_clear_role(struct wayland_surface *surface)
 
     case WAYLAND_SURFACE_ROLE_DND_ICON:
         break;
+
+    case WAYLAND_SURFACE_ROLE_LAYER:
+        if (surface->layer_surface)
+        {
+            zwlr_layer_surface_v1_destroy(surface->layer_surface);
+            surface->layer_surface = NULL;
+        }
+        surface->layer_configured = FALSE;
+        break;
     }
 
     memset(&surface->pending, 0, sizeof(surface->pending));
@@ -1251,6 +1370,11 @@ BOOL wayland_surface_reconfigure(struct wayland_surface *surface)
     case WAYLAND_SURFACE_ROLE_DND_ICON:
         wayland_surface_reconfigure_dnd_icon(surface);
         break;
+    case WAYLAND_SURFACE_ROLE_LAYER:
+        if (!surface->layer_surface) break; /* closed or role cleared */
+        if (!surface->layer_configured) return FALSE;
+        wayland_surface_reconfigure_layer(surface);
+        break;
     }
 
     wayland_surface_reconfigure_size(surface, rect.right - rect.left, rect.bottom - rect.top);
