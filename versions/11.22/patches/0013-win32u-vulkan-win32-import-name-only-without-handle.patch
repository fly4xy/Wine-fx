From: Wine Fox
Subject: [PATCH] win32u: Imports of Win32 handles use the name only without a handle.

VkImportMemoryWin32HandleInfoKHR, VkImportSemaphoreWin32HandleInfoKHR and
VkImportFenceWin32HandleInfoKHR carry a handle or a name; with a handle the name has to be NULL,
and Windows drivers do not read it then. Substance Designer imports its textures with a handle
and garbage in the name: Wine read the name first and crashed in vkAllocateMemory
(Exception 0xc0000005 in Unix call). The name is now looked at only when there is no handle.

diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index f8aedfc..8f4a6aa 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -963,7 +963,8 @@ static VkResult win32u_vkAllocateMemory( VkDevice client_device, const VkMemoryA
         case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D12_RESOURCE_BIT:
         {
             HANDLE shared = import_win32->handle;
-            if (import_win32->name && !(shared = open_shared_resource_from_name( import_win32->name ))) break;
+            /* the name only without a handle (applications leave garbage in it, Substance Designer) */
+            if (!shared && import_win32->name && !(shared = open_shared_resource_from_name( import_win32->name ))) break;
             memory->local = d3dkmt_open_resource( 0, shared, &memory->mutex, &memory->sync );
             if (shared && shared != import_win32->handle) NtClose( shared );
             break;
@@ -2644,7 +2645,7 @@ static VkResult win32u_vkImportSemaphoreWin32HandleKHR( VkDevice client_device,
         break;
     case VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT:
     case VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_D3D12_FENCE_BIT:
-        if (handle_info->name && !(shared = open_shared_semaphore_from_name( handle_info->name )))
+        if (!handle_info->handle && handle_info->name && !(shared = open_shared_semaphore_from_name( handle_info->name )))
             return VK_ERROR_INVALID_EXTERNAL_HANDLE;
         else if (!(shared = handle_info->handle) || NtDuplicateObject( NtCurrentProcess(), shared, NtCurrentProcess(), &shared,
                                                                        0, 0, DUPLICATE_SAME_ATTRIBUTES | DUPLICATE_SAME_ACCESS ))
@@ -2911,7 +2912,7 @@ static VkResult win32u_vkImportFenceWin32HandleKHR( VkDevice client_device, cons
         if (!(local = d3dkmt_open_sync( global, NULL ))) return VK_ERROR_INVALID_EXTERNAL_HANDLE;
         break;
     case VK_EXTERNAL_FENCE_HANDLE_TYPE_OPAQUE_WIN32_BIT:
-        if (handle_info->name && !(shared = open_shared_semaphore_from_name( handle_info->name )))
+        if (!handle_info->handle && handle_info->name && !(shared = open_shared_semaphore_from_name( handle_info->name )))
             return VK_ERROR_INVALID_EXTERNAL_HANDLE;
         else if (!(shared = handle_info->handle) || NtDuplicateObject( NtCurrentProcess(), shared, NtCurrentProcess(), &shared,
                                                                        0, 0, DUPLICATE_SAME_ATTRIBUTES | DUPLICATE_SAME_ACCESS ))
