From: Wine Fox
Subject: [PATCH] winex11, winewayland: Window regions of client surfaces under X11; whether the pointer is over a Wine window.

* winex11: Window regions of client surfaces; whether the pointer is over a Wine window.

Tooltips and popups of programs that draw with Vulkan or OpenGL (Unreal Engine) were black
outside their window region, or cut off: a client window that draws directly now gets the
window's region as its X shape, and gives it back to the window surface when it is detached.
The driver also answers whether the X window under the pointer is one of Wine's
(X11DRV_QUERY_POINTER_WINDOW, cached briefly): user32's WindowFromPoint uses it so that
tooltips do not show over other applications covering Wine's windows.

* winewayland: Answer whether the cursor is over a Wine window.

WindowFromPoint() (patch 0002) asks the display driver whether the cursor is over one of our
windows, with the X11 driver's escape: the server only knows Wine windows and returns ours
also when another application covers them, so Unreal Engine's tooltips stayed on top of
other applications. Under Wayland nothing answered and the tooltips stayed.

Wayland tells a client when the pointer enters and leaves its surfaces. The driver gets a
display DC driver for the escape: with no surface of this process under the pointer, the
cursor is over another application, unless the window there belongs to another Wine process
(only that process knows).

diff --git a/dlls/winewayland.drv/wayland_pointer.c b/dlls/winewayland.drv/wayland_pointer.c
index 0c190a9..ed6deda 100755
--- a/dlls/winewayland.drv/wayland_pointer.c
+++ b/dlls/winewayland.drv/wayland_pointer.c
@@ -1083,3 +1083,74 @@ BOOL WAYLAND_ClipCursor(const RECT *clip, BOOL reset)
 
     return TRUE;
 }
+
+/* WindowFromPoint() in user32 (Wine Fox) asks the display driver whether the cursor is over
+ * one of our windows: the server knows only Wine windows and returns ours also when another
+ * application covers them, so tooltips of such windows (Unreal Engine's) stay on top of other
+ * applications. The query is the escape of the X11 driver (see dlls/winex11.drv/x11drv.h). */
+#define X11DRV_ESCAPE 6789
+#define X11DRV_QUERY_POINTER_WINDOW 4
+
+struct query_pointer_window
+{
+    int   code;      /* X11DRV_QUERY_POINTER_WINDOW */
+    POINT pos;       /* the cursor position the answer is for */
+    BOOL  over_wine; /* the cursor is over a Wine window */
+};
+
+/* Wayland tells a client when the pointer enters and leaves its surfaces: with no surface of
+ * this process under the pointer, it is over another application, or over a window of another
+ * Wine process, which only that process knows. */
+static BOOL wayland_pointer_over_wine(POINT *pos)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    BOOL have_pointer;
+    HWND focused, hwnd;
+    DWORD pid;
+
+    NtUserGetCursorPos(pos);
+
+    pthread_mutex_lock(&pointer->mutex);
+    have_pointer = pointer->wl_pointer != NULL;
+    focused = pointer->focused_hwnd;
+    pthread_mutex_unlock(&pointer->mutex);
+
+    if (!have_pointer || focused) return TRUE;
+    hwnd = NtUserWindowFromPoint(pos->x, pos->y);
+    if (hwnd && NtUserGetWindowThread(hwnd, &pid) && pid != GetCurrentProcessId()) return TRUE;
+    TRACE("cursor at %s is over another application\n", wine_dbgstr_point(pos));
+    return FALSE;
+}
+
+/* The display DC driver, for the escape above only. */
+BOOL WAYLAND_CreateDC(PHYSDEV *pdev, LPCWSTR device, LPCWSTR output, const DEVMODEW *devmode)
+{
+    PHYSDEV physdev = calloc(1, sizeof(*physdev));
+
+    if (!physdev) return FALSE;
+    push_dc_driver(pdev, physdev, get_display_driver_funcs());
+    return TRUE;
+}
+
+BOOL WAYLAND_DeleteDC(PHYSDEV dev)
+{
+    free(dev);
+    return TRUE;
+}
+
+INT WAYLAND_ExtEscape(PHYSDEV dev, INT escape, INT in_count, LPCVOID in_data,
+                      INT out_count, LPVOID out_data)
+{
+    if (escape == X11DRV_ESCAPE && in_data && in_count >= sizeof(int) &&
+        *(const int *)in_data == X11DRV_QUERY_POINTER_WINDOW &&
+        out_count >= sizeof(struct query_pointer_window))
+    {
+        struct query_pointer_window *query = out_data;
+
+        query->code = X11DRV_QUERY_POINTER_WINDOW;
+        query->over_wine = wayland_pointer_over_wine(&query->pos);
+        return TRUE;
+    }
+    dev = GET_NEXT_PHYSDEV(dev, pExtEscape);
+    return dev->funcs->pExtEscape(dev, escape, in_count, in_data, out_count, out_data);
+}
