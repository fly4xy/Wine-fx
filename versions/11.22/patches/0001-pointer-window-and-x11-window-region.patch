+BOOL WAYLAND_CreateDC(PHYSDEV *pdev, LPCWSTR device, LPCWSTR output, const DEVMODEW *devmode);
+BOOL WAYLAND_DeleteDC(PHYSDEV dev);
+INT WAYLAND_ExtEscape(PHYSDEV dev, INT escape, INT in_count, LPCVOID in_data, INT out_count, LPVOID out_data);
 
 /**********************************************************************
  *          Wayland text input
