+    if (!toplevel || !GetWindowThreadProcessId(toplevel, &pid) || pid == GetCurrentProcessId()
+            || GetPropA(toplevel, "__wine_x11_whole_window"))
+        return FALSE;
+
+    if (pid != swapchain->composition_pid)
+    {
+        if (swapchain->composition_process)
+            CloseHandle(swapchain->composition_process);
+        swapchain->composition_pid = pid;
+        if (!(swapchain->composition_process = OpenProcess(PROCESS_DUP_HANDLE, FALSE, pid)))
+            ERR("Failed to open process %04lx, error %lu.\n", pid, GetLastError());
+    }
+    if (!swapchain->composition_process)
+        return TRUE;
