+    size = sizeof(*frame) + (SIZE_T)width * 4 * height;
+    if (size > swapchain->composition_size)
+    {
+        if (swapchain->composition_view)
+            UnmapViewOfFile(swapchain->composition_view);
+        if (swapchain->composition_section)
+            CloseHandle(swapchain->composition_section);
+        swapchain->composition_view = NULL;
+        swapchain->composition_size = 0;
