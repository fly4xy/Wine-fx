+ * top level is another process' (and not an X11 window, which GDI reaches from here), hand the
+ * frame to that process in a section. Returns FALSE if the frame should be drawn here. */
+static BOOL d3d11_swapchain_present_composition_remote(struct d3d11_swapchain *swapchain,
+        HWND window, const D3D11_MAPPED_SUBRESOURCE *map, UINT width, UINT height)
+{
+    HWND toplevel = GetAncestor(window, GA_ROOT);
+    struct composition_frame *frame;
+    HANDLE remote;
+    SIZE_T size;
+    DWORD pid;
+    UINT y;
