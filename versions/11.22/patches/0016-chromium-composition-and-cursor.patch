+/***********************************************************************
+ *           present_composition_frame
+ *
+ * Draw a frame that another process (dxgi's composition swapchains) put in a section, in a
+ * window of a top level of this process: only this process can draw in that top level's surface.
+ */
+void present_composition_frame( HWND hwnd, HANDLE section )
+{
+    BITMAPINFO info = {{sizeof(info.bmiHeader)}};
+    const struct composition_frame *frame;
+    void *view = NULL;
+    SIZE_T size = 0;
+    HDC hdc;
+
+    if (!NtMapViewOfSection( section, GetCurrentProcess(), &view, 0, 0, NULL, &size, ViewShare, 0, PAGE_READONLY ))
+    {
+        frame = view;
+        /* the section comes from another process: check that the frame fits in it */
+        if (size >= sizeof(*frame) && frame->width && frame->height && frame->stride / 4 >= frame->width &&
+            !(frame->stride % 4) && frame->width <= 0x8000 && frame->height <= 0x8000 &&
+            (size - sizeof(*frame)) / frame->stride >= frame->height &&
+            (hdc = NtUserGetDCEx( hwnd, 0, DCX_USESTYLE )))
+        {
+            info.bmiHeader.biWidth = frame->stride / 4;
+            info.bmiHeader.biHeight = -(LONG)frame->height;
+            info.bmiHeader.biPlanes = 1;
+            info.bmiHeader.biBitCount = 32;
+            info.bmiHeader.biCompression = BI_RGB;
+            NtGdiSetDIBitsToDeviceInternal( hdc, 0, 0, frame->width, frame->height, 0, 0, 0, frame->height,
+                                            frame + 1, &info, DIB_RGB_COLORS, 0, 0, FALSE, NULL );
+            NtUserReleaseDC( hwnd, hdc );
+        }
+        else WARN( "invalid composition frame for %p, section size %#zx\n", hwnd, (size_t)size );
+        NtUnmapViewOfSection( GetCurrentProcess(), view );
+    }
+    NtClose( section );
+}
