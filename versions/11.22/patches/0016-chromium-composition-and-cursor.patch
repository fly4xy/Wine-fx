+/* the window under the point (in absolute raw coords) in top-level 'scope' when it belongs to
+ * another process (Chromium's browser process in a launcher's window): its thread gets the mouse
+ * messages and sets the cursor, so it is the cursor window; else 'scope' */
+user_handle_t cursor_window_from_point( user_handle_t scope, int x, int y )
+{
+    struct window *top = get_user_object( scope, NTUSER_OBJ_WINDOW ), *win;
+
+    if (!top || !top->thread || top == top->desktop->top_window) return scope;
+    if (!get_monitor_dpi( top ).den) return scope;  /* not placed on a monitor yet: would divide by 0 */
+
+    map_point_raw_to_virt( top->desktop, &x, &y );
+    screen_to_client( top, &x, &y, no_dpi );
+    win = child_window_from_point( top, x, y );
+    if (!win->thread || win->thread->process == top->thread->process) return scope;
+    return win->handle;
+}
