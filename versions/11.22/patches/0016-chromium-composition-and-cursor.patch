 WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
 
-HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
+/* A minimal IDCompositionDevice: a target window shows the swapchain that is the content of
+ * its root visual (what Chromium's software output device builds). Child visuals, offsets,
+ * transforms, clips and surfaces are not composed. */
+
+struct composition_visual
 {
-    FIXME("%p, %s, %p.\n", dxgi_device, debugstr_guid(iid), device);
+    IDCompositionVisual IDCompositionVisual_iface;
+    LONG refcount;
+    IUnknown *content;
+};
 
-    return E_NOTIMPL;
+struct composition_device
+{
+    IDCompositionDevice IDCompositionDevice_iface;
+    LONG refcount;
+    struct list targets;
+};
+
+struct composition_target
+{
+    IDCompositionTarget IDCompositionTarget_iface;
+    LONG refcount;
+    struct composition_device *device;
+    struct list entry;
+    HWND hwnd;
+    struct composition_visual *root;
+    IDXGISwapChain *shown;
+};
+
+static const IDCompositionVisualVtbl visual_vtbl;
+
+static struct composition_visual *impl_from_IDCompositionVisual(IDCompositionVisual *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_visual, IDCompositionVisual_iface);
+}
+
+static struct composition_visual *unsafe_impl_from_IDCompositionVisual(IDCompositionVisual *iface)
+{
+    if (!iface || iface->lpVtbl != &visual_vtbl)
+        return NULL;
+    return impl_from_IDCompositionVisual(iface);
+}
+
+static HRESULT STDMETHODCALLTYPE visual_QueryInterface(IDCompositionVisual *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IDCompositionVisual) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IDCompositionVisual_AddRef(*out = iface);
+        return S_OK;
+    }
+
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE visual_AddRef(IDCompositionVisual *iface)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual(iface);
+    ULONG refcount = InterlockedIncrement(&visual->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE visual_Release(IDCompositionVisual *iface)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual(iface);
+    ULONG refcount = InterlockedDecrement(&visual->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+    if (!refcount)
+    {
+        if (visual->content)
+            IUnknown_Release(visual->content);
+        free(visual);
+    }
+    return refcount;
+}
+
+#define VISUAL_IGNORED(name, args) \
+    static HRESULT STDMETHODCALLTYPE visual_##name args \
+    { \
+        FIXME("iface %p, ignored.\n", iface); \
+        return S_OK; \
+    }
+
+VISUAL_IGNORED(SetOffsetXAnimation, (IDCompositionVisual *iface, IDCompositionAnimation *animation))
+VISUAL_IGNORED(SetOffsetX, (IDCompositionVisual *iface, float offset_x))
+VISUAL_IGNORED(SetOffsetYAnimation, (IDCompositionVisual *iface, IDCompositionAnimation *animation))
+VISUAL_IGNORED(SetOffsetY, (IDCompositionVisual *iface, float offset_y))
+VISUAL_IGNORED(SetTransformObject, (IDCompositionVisual *iface, IDCompositionTransform *transform))
+VISUAL_IGNORED(SetTransform, (IDCompositionVisual *iface, const D2D_MATRIX_3X2_F *matrix))
+VISUAL_IGNORED(SetTransformParent, (IDCompositionVisual *iface, IDCompositionVisual *visual))
+VISUAL_IGNORED(SetEffect, (IDCompositionVisual *iface, IDCompositionEffect *effect))
+VISUAL_IGNORED(SetBitmapInterpolationMode, (IDCompositionVisual *iface, enum DCOMPOSITION_BITMAP_INTERPOLATION_MODE mode))
+VISUAL_IGNORED(SetBorderMode, (IDCompositionVisual *iface, enum DCOMPOSITION_BORDER_MODE mode))
+VISUAL_IGNORED(SetClipObject, (IDCompositionVisual *iface, IDCompositionClip *clip))
+VISUAL_IGNORED(SetClip, (IDCompositionVisual *iface, const D2D_RECT_F *rect))
+VISUAL_IGNORED(AddVisual, (IDCompositionVisual *iface, IDCompositionVisual *visual, BOOL insert_above, IDCompositionVisual *reference))
+VISUAL_IGNORED(RemoveVisual, (IDCompositionVisual *iface, IDCompositionVisual *visual))
+VISUAL_IGNORED(RemoveAllVisuals, (IDCompositionVisual *iface))
+VISUAL_IGNORED(SetCompositeMode, (IDCompositionVisual *iface, enum DCOMPOSITION_COMPOSITE_MODE mode))
+
+static HRESULT STDMETHODCALLTYPE visual_SetContent(IDCompositionVisual *iface, IUnknown *content)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual(iface);
+
+    TRACE("iface %p, content %p.\n", iface, content);
+
+    if (content)
+        IUnknown_AddRef(content);
+    if (visual->content)
+        IUnknown_Release(visual->content);
+    visual->content = content;
+    return S_OK;
+}
+
+static const IDCompositionVisualVtbl visual_vtbl =
+{
+    visual_QueryInterface,
+    visual_AddRef,
+    visual_Release,
+    visual_SetOffsetXAnimation,
+    visual_SetOffsetX,
+    visual_SetOffsetYAnimation,
+    visual_SetOffsetY,
+    visual_SetTransformObject,
+    visual_SetTransform,
+    visual_SetTransformParent,
+    visual_SetEffect,
+    visual_SetBitmapInterpolationMode,
+    visual_SetBorderMode,
+    visual_SetClipObject,
+    visual_SetClip,
+    visual_SetContent,
+    visual_AddVisual,
+    visual_RemoveVisual,
+    visual_RemoveAllVisuals,
+    visual_SetCompositeMode,
+};
+
+/* Tell dxgi which window a composition swapchain presents to (NULL: none). */
+static void show_swapchain(IDXGISwapChain *swapchain, HWND hwnd)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = IDXGISwapChain_SetPrivateData(swapchain, &WINE_DXGI_COMPOSITION_WINDOW, sizeof(hwnd), &hwnd)))
+        WARN("Failed to set the window of swapchain %p, hr %#lx.\n", swapchain, hr);
+}
+
+static void target_update(struct composition_target *target)
+{
+    IDXGISwapChain *swapchain = NULL;
+
+    if (target->root && target->root->content)
+        IUnknown_QueryInterface(target->root->content, &IID_IDXGISwapChain, (void **)&swapchain);
+    if (swapchain == target->shown)
+    {
+        if (swapchain)
+            IDXGISwapChain_Release(swapchain);
+        return;
+    }
+    if (target->shown)
+    {
+        show_swapchain(target->shown, NULL);
+        IDXGISwapChain_Release(target->shown);
+    }
+    if ((target->shown = swapchain))
+        show_swapchain(swapchain, target->hwnd);
+    TRACE("Target %p (window %p) shows swapchain %p.\n", target, target->hwnd, swapchain);
+}
+
+static struct composition_target *impl_from_IDCompositionTarget(IDCompositionTarget *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_target, IDCompositionTarget_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE target_QueryInterface(IDCompositionTarget *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IDCompositionTarget) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IDCompositionTarget_AddRef(*out = iface);
+        return S_OK;
+    }
+
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE target_AddRef(IDCompositionTarget *iface)
+{
+    struct composition_target *target = impl_from_IDCompositionTarget(iface);
+    ULONG refcount = InterlockedIncrement(&target->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE target_Release(IDCompositionTarget *iface)
+{
+    struct composition_target *target = impl_from_IDCompositionTarget(iface);
+    ULONG refcount = InterlockedDecrement(&target->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+    if (!refcount)
+    {
+        if (target->shown)
+        {
+            show_swapchain(target->shown, NULL);
+            IDXGISwapChain_Release(target->shown);
+        }
+        if (target->root)
+            IDCompositionVisual_Release(&target->root->IDCompositionVisual_iface);
+        list_remove(&target->entry);
+        IDCompositionDevice_Release(&target->device->IDCompositionDevice_iface);
+        free(target);
+    }
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE target_SetRoot(IDCompositionTarget *iface, IDCompositionVisual *visual)
+{
+    struct composition_target *target = impl_from_IDCompositionTarget(iface);
+    struct composition_visual *root = unsafe_impl_from_IDCompositionVisual(visual);
+
+    TRACE("iface %p, visual %p.\n", iface, visual);
+
+    if (visual && !root)
+        return E_INVALIDARG;
+    if (root)
+        IDCompositionVisual_AddRef(visual);
+    if (target->root)
+        IDCompositionVisual_Release(&target->root->IDCompositionVisual_iface);
+    target->root = root;
+    return S_OK;
+}
+
+static const IDCompositionTargetVtbl target_vtbl =
+{
+    target_QueryInterface,
+    target_AddRef,
+    target_Release,
+    target_SetRoot,
+};
+
+static struct composition_device *impl_from_IDCompositionDevice(IDCompositionDevice *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_device, IDCompositionDevice_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE device_QueryInterface(IDCompositionDevice *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IDCompositionDevice) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IDCompositionDevice_AddRef(*out = iface);
+        return S_OK;
+    }
+
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE device_AddRef(IDCompositionDevice *iface)
+{
+    struct composition_device *device = impl_from_IDCompositionDevice(iface);
+    ULONG refcount = InterlockedIncrement(&device->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE device_Release(IDCompositionDevice *iface)
+{
+    struct composition_device *device = impl_from_IDCompositionDevice(iface);
+    ULONG refcount = InterlockedDecrement(&device->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+    if (!refcount)
+        free(device);
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE device_Commit(IDCompositionDevice *iface)
+{
+    struct composition_device *device = impl_from_IDCompositionDevice(iface);
+    struct composition_target *target;
+
+    TRACE("iface %p.\n", iface);
+
+    /* shortcut: no lock, callers commit from the thread that builds the tree (Chromium does);
+     * add a critical section if a multithreaded user shows up. */
+    LIST_FOR_EACH_ENTRY(target, &device->targets, struct composition_target, entry)
+        target_update(target);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE device_WaitForCommitCompletion(IDCompositionDevice *iface)
+{
+    TRACE("iface %p.\n", iface);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE device_CreateTargetForHwnd(IDCompositionDevice *iface,
+        HWND hwnd, BOOL topmost, IDCompositionTarget **out)
+{
+    struct composition_device *device = impl_from_IDCompositionDevice(iface);
+    struct composition_target *target;
+
+    TRACE("iface %p, hwnd %p, topmost %d, out %p.\n", iface, hwnd, topmost, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+    if (!IsWindow(hwnd))
+        return E_INVALIDARG;
+    if (!(target = calloc(1, sizeof(*target))))
+        return E_OUTOFMEMORY;
+    target->IDCompositionTarget_iface.lpVtbl = &target_vtbl;
+    target->refcount = 1;
+    target->hwnd = hwnd;
+    target->device = device;
+    IDCompositionDevice_AddRef(iface);
+    list_add_tail(&device->targets, &target->entry);
+    *out = &target->IDCompositionTarget_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE device_CreateVisual(IDCompositionDevice *iface, IDCompositionVisual **out)
+{
+    struct composition_visual *visual;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!(visual = calloc(1, sizeof(*visual))))
+        return E_OUTOFMEMORY;
+    visual->IDCompositionVisual_iface.lpVtbl = &visual_vtbl;
+    visual->refcount = 1;
+    *out = &visual->IDCompositionVisual_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE device_CheckDeviceState(IDCompositionDevice *iface, BOOL *valid)
+{
+    TRACE("iface %p, valid %p.\n", iface, valid);
+
+    if (!valid)
+        return E_INVALIDARG;
+    *valid = TRUE;
+    return S_OK;
+}
+
+#define DEVICE_NOTIMPL(name, args) \
+    static HRESULT STDMETHODCALLTYPE device_##name args \
+    { \
+        FIXME("iface %p, stub!\n", iface); \
+        return E_NOTIMPL; \
+    }
+
+DEVICE_NOTIMPL(GetFrameStatistics, (IDCompositionDevice *iface, DCOMPOSITION_FRAME_STATISTICS *statistics))
+DEVICE_NOTIMPL(CreateSurface, (IDCompositionDevice *iface, UINT width, UINT height, DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, IDCompositionSurface **surface))
+DEVICE_NOTIMPL(CreateVirtualSurface, (IDCompositionDevice *iface, UINT width, UINT height, DXGI_FORMAT format, DXGI_ALPHA_MODE alpha_mode, IDCompositionVirtualSurface **surface))
+DEVICE_NOTIMPL(CreateSurfaceFromHandle, (IDCompositionDevice *iface, HANDLE handle, IUnknown **surface))
+DEVICE_NOTIMPL(CreateSurfaceFromHwnd, (IDCompositionDevice *iface, HWND hwnd, IUnknown **surface))
+DEVICE_NOTIMPL(CreateTranslateTransform, (IDCompositionDevice *iface, IDCompositionTranslateTransform **transform))
+DEVICE_NOTIMPL(CreateScaleTransform, (IDCompositionDevice *iface, IDCompositionScaleTransform **transform))
+DEVICE_NOTIMPL(CreateRotateTransform, (IDCompositionDevice *iface, IDCompositionRotateTransform **transform))
+DEVICE_NOTIMPL(CreateSkewTransform, (IDCompositionDevice *iface, IDCompositionSkewTransform **transform))
+DEVICE_NOTIMPL(CreateMatrixTransform, (IDCompositionDevice *iface, IDCompositionMatrixTransform **transform))
+DEVICE_NOTIMPL(CreateTransformGroup, (IDCompositionDevice *iface, IDCompositionTransform **transforms, UINT elements, IDCompositionTransform **group))
+DEVICE_NOTIMPL(CreateTranslateTransform3D, (IDCompositionDevice *iface, IDCompositionTranslateTransform3D **transform))
+DEVICE_NOTIMPL(CreateScaleTransform3D, (IDCompositionDevice *iface, IDCompositionScaleTransform3D **transform))
+DEVICE_NOTIMPL(CreateRotateTransform3D, (IDCompositionDevice *iface, IDCompositionRotateTransform3D **transform))
+DEVICE_NOTIMPL(CreateMatrixTransform3D, (IDCompositionDevice *iface, IDCompositionMatrixTransform3D **transform))
+DEVICE_NOTIMPL(CreateTransform3DGroup, (IDCompositionDevice *iface, IDCompositionTransform3D **transforms, UINT elements, IDCompositionTransform3D **group))
+DEVICE_NOTIMPL(CreateEffectGroup, (IDCompositionDevice *iface, IDCompositionEffectGroup **group))
+DEVICE_NOTIMPL(CreateRectangleClip, (IDCompositionDevice *iface, IDCompositionRectangleClip **clip))
+DEVICE_NOTIMPL(CreateAnimation, (IDCompositionDevice *iface, IDCompositionAnimation **animation))
+
+static const IDCompositionDeviceVtbl device_vtbl =
+{
+    device_QueryInterface,
+    device_AddRef,
+    device_Release,
+    device_Commit,
+    device_WaitForCommitCompletion,
+    device_GetFrameStatistics,
+    device_CreateTargetForHwnd,
+    device_CreateVisual,
+    device_CreateSurface,
+    device_CreateVirtualSurface,
+    device_CreateSurfaceFromHandle,
+    device_CreateSurfaceFromHwnd,
+    device_CreateTranslateTransform,
+    device_CreateScaleTransform,
+    device_CreateRotateTransform,
+    device_CreateSkewTransform,
+    device_CreateMatrixTransform,
+    device_CreateTransformGroup,
+    device_CreateTranslateTransform3D,
+    device_CreateScaleTransform3D,
+    device_CreateRotateTransform3D,
+    device_CreateMatrixTransform3D,
+    device_CreateTransform3DGroup,
+    device_CreateEffectGroup,
+    device_CreateRectangleClip,
+    device_CreateAnimation,
+    device_CheckDeviceState,
+};
+
+HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **out)
+{
+    struct composition_device *device;
+    HRESULT hr;
+
+    TRACE("%p, %s, %p.\n", dxgi_device, debugstr_guid(iid), out);
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+    if (!(device = calloc(1, sizeof(*device))))
+        return E_OUTOFMEMORY;
+    device->IDCompositionDevice_iface.lpVtbl = &device_vtbl;
+    device->refcount = 1;
+    list_init(&device->targets);
+
+    hr = IDCompositionDevice_QueryInterface(&device->IDCompositionDevice_iface, iid, out);
+    IDCompositionDevice_Release(&device->IDCompositionDevice_iface);
+    return hr;
 }
 
 HRESULT WINAPI DCompositionCreateDevice2(IUnknown *rendering_device, REFIID iid, void **device)
