+/* A window in a top level of another process (Chromium's browser process in the launcher's
+ * window): the pointer is that process' surface, and only it can set the cursor. It gets the
+ * cursor as a shape. shortcut: cursors that are not a system one show as the default arrow, and
+ * a compositor without cursor-shape-v1 shows none; send the image for those if one needs it. */
+static BOOL wayland_set_cursor_in_remote_toplevel(HWND hwnd, HCURSOR hcursor)
+{
+    HWND toplevel = hwnd ? NtUserGetAncestor(hwnd, GA_ROOT) : 0;
+    ICONINFOEXW info = {0};
+    UINT shape = ~0u;
+    DWORD pid;
+
+    if (!toplevel || !NtUserGetWindowThread(toplevel, &pid) || pid == GetCurrentProcessId()) return FALSE;
+    if (hcursor)
+    {
+        shape = 0;
+        if (get_icon_info(hcursor, &info))
+        {
+            shape = cursor_shape_from_info(&info, process_wayland.wp_cursor_shape_manager_v1 ?
+                wp_cursor_shape_manager_v1_get_version(process_wayland.wp_cursor_shape_manager_v1) : 1);
+            if (info.hbmColor) NtGdiDeleteObjectApp(info.hbmColor);
+            if (info.hbmMask) NtGdiDeleteObjectApp(info.hbmMask);
+        }
+        if (!shape) shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+    }
+    TRACE("hwnd=%p toplevel=%p of pid %04x, shape %#x\n", hwnd, toplevel, (int)pid, shape);
+    NtUserPostMessage(toplevel, WM_WAYLAND_REMOTE_CURSOR, 0, shape);
+    return TRUE;
+}
