+    }
     else if (strcmp(interface, "xdg_toplevel_icon_manager_v1") == 0)
     {
         process_wayland.xdg_toplevel_icon_manager_v1 =
diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index a1b1587..f94a5af 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -436,6 +436,13 @@ void wayland_surface_make_toplevel(struct wayland_surface *surface)
     if (!surface->xdg_toplevel) goto err;
     xdg_toplevel_add_listener(surface->xdg_toplevel, &xdg_toplevel_listener, surface->hwnd);
 
+    /* The desktop's frame, for the windows that have one: its mode follows the window's style
+     * and rects (wayland_win_data_update_decoration). Created now, before the first commit. */
+    if (process_wayland.zxdg_decoration_manager_v1)
+        surface->xdg_toplevel_decoration = zxdg_decoration_manager_v1_get_toplevel_decoration(
+            process_wayland.zxdg_decoration_manager_v1, surface->xdg_toplevel);
+    surface->xdg_decoration_mode = 0;
+
     /* WINEWMCLASS: the app_id to give the windows, as the window class for winex11 (Epic Games'
      * winex11-set-wm-class patch): what the desktop matches with StartupWMClass of a menu entry */
     if ((app_id = getenv("WINEWMCLASS")) && *app_id)
@@ -540,6 +547,12 @@ void wayland_surface_clear_role(struct wayland_surface *surface)
 
         if (surface->xdg_toplevel)
         {
+            /* before its toplevel, as the protocol wants */
+            if (surface->xdg_toplevel_decoration)
+            {
+                zxdg_toplevel_decoration_v1_destroy(surface->xdg_toplevel_decoration);
+                surface->xdg_toplevel_decoration = NULL;
+            }
             xdg_toplevel_destroy(surface->xdg_toplevel);
             surface->xdg_toplevel = NULL;
         }
