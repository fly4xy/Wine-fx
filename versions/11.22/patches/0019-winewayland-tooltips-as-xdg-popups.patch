     WAYLAND_SURFACE_ROLE_TOPLEVEL,
     WAYLAND_SURFACE_ROLE_SUBSURFACE,
+    WAYLAND_SURFACE_ROLE_POPUP,       /* xdg_popup: tooltips, kept on the screen by the compositor */
 };
 
 struct wayland_keyboard
@@ -320,6 +321,15 @@ struct wayland_surface
         };
     };
     struct wp_alpha_modifier_surface_v1 *wp_alpha_modifier_surface_v1;
+    /* WAYLAND_SURFACE_ROLE_POPUP */
+    struct xdg_surface *popup_xdg_surface;
+    struct xdg_popup *xdg_popup;
+    HWND popup_owner_hwnd;
