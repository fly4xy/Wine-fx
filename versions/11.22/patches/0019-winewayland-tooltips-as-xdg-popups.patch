diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 47364d1..0b303bf 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -172,6 +172,26 @@ static void reapply_cursor_clipping(void)
     NtUserSetThreadDpiAwarenessContext(context);
 }
 
+/* Tooltips, owned by a toplevel of ours: as xdg_popups the compositor keeps them on the screen.
+ * The common controls' tooltips (UnrealGameSync and other programs), and Unreal Engine's: layered
+ * popups that stay on top and are not in the taskbar, with mouse input (not the decorator of a
+ * tab it drags, which follows the pointer). Not other topmost tool popups (drop-down lists).
+ * Needs xdg_wm_base 3 (xdg_popup.reposition). */
+static BOOL is_tooltip(HWND hwnd, struct wayland_surface *owner_surface)
+{
+    static const WCHAR tooltipsW[] = {'t','o','o','l','t','i','p','s','_','c','l','a','s','s','3','2',0};
+    DWORD style = NtUserGetWindowLongW(hwnd, GWL_STYLE), ex_style = NtUserGetWindowLongW(hwnd, GWL_EXSTYLE);
+    WCHAR buffer[64];
+    UNICODE_STRING name = {.Buffer = buffer, .MaximumLength = sizeof(buffer)};
+
+    if (!owner_surface || !wayland_surface_is_toplevel(owner_surface) || !owner_surface->xdg_surface) return FALSE;
+    if (xdg_wm_base_get_version(process_wayland.xdg_wm_base) < 3) return FALSE;
+    if ((style & (WS_POPUP | WS_CHILD)) != WS_POPUP) return FALSE;
+    if (NtUserGetClassName(hwnd, FALSE, &name) && !wcsicmp(buffer, tooltipsW)) return TRUE;
+    return (ex_style & (WS_EX_LAYERED | WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_TRANSPARENT | WS_EX_APPWINDOW)) ==
+           (WS_EX_LAYERED | WS_EX_TOPMOST | WS_EX_TOOLWINDOW);
+}
+
 static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *data, struct wayland_surface *owner_surface)
 {
     struct wayland_surface *surface;
@@ -186,6 +206,7 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
                (!(exstyle & WS_EX_LAYERED) || data->layered_attribs_set);
 
     if (!visible) role = WAYLAND_SURFACE_ROLE_NONE;
+    else if (!data->managed && is_tooltip(data->hwnd, owner_surface)) role = WAYLAND_SURFACE_ROLE_POPUP;
     else if (owner_surface) role = WAYLAND_SURFACE_ROLE_SUBSURFACE;
     else role = WAYLAND_SURFACE_ROLE_TOPLEVEL;
 
@@ -204,7 +225,9 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
 
     /* Pass through mouse events for layered, transparent windows, to match
      * Windows behavior. */
-    input_region = ((exstyle & WS_EX_TRANSPARENT) && (exstyle & WS_EX_LAYERED)) ?
+    /* and tooltips: slid in at the edge of the screen one can be under the pointer, and the item
+     * it is the tooltip of losing the pointer hides it (it flickered, at the right edge) */
+    input_region = (role == WAYLAND_SURFACE_ROLE_POPUP || ((exstyle & WS_EX_TRANSPARENT) && (exstyle & WS_EX_LAYERED))) ?
                    wl_compositor_create_region(process_wayland.wl_compositor) :
                    NULL;
     wl_surface_set_input_region(surface->wl_surface, input_region);
@@ -224,6 +247,11 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
     case WAYLAND_SURFACE_ROLE_SUBSURFACE:
         wayland_surface_make_subsurface(surface, owner_surface);
         break;
+    case WAYLAND_SURFACE_ROLE_POPUP:
+        /* its place is needed to create it */
+        wayland_win_data_get_config(data, &surface->window);
+        wayland_surface_make_popup(surface, owner_surface);
+        break;
     }
 
     wayland_win_data_get_config(data, &surface->window);
@@ -321,6 +349,10 @@ static void wayland_win_data_update_wayland_state(struct wayland_win_data *data)
         wayland_win_data_update_decoration(data);
         wayland_surface_update_state_toplevel(surface);
         break;
+    case WAYLAND_SURFACE_ROLE_POPUP:
+        /* moved without being drawn again: no flush would reposition it */
+        if (surface->xdg_popup && surface->popup_configured) wayland_surface_reconfigure_popup(surface);
+        break;
     case WAYLAND_SURFACE_ROLE_SUBSURFACE:
         TRACE("hwnd=%p subsurface owner=%p\n", surface->hwnd, surface->owner_hwnd);
         /* Although subsurfaces don't have a dedicated surface config mechanism,
@@ -747,14 +779,18 @@ LRESULT WAYLAND_WindowMessage(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 
         if (!(data = wayland_win_data_get(hwnd))) return 0;
         rect = data->rects.window;
+        wayland_win_data_release(data);
+        OffsetRect(&rect, (int)wp, (int)lp);
+        NtUserSetRawWindowPos(hwnd, rect, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER, FALSE);
+        /* the move done: no longer pending (moving, the window is where its old place plus the
+         * pending move says, and once moved, its new place) */
+        if (!(data = wayland_win_data_get(hwnd))) return 0;
         if (data->wayland_surface)
         {
             data->wayland_surface->align.x -= (int)wp;
             data->wayland_surface->align.y -= (int)lp;
         }
         wayland_win_data_release(data);
-        OffsetRect(&rect, (int)wp, (int)lp);
-        NtUserSetRawWindowPos(hwnd, rect, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER, FALSE);
         return 0;
     }
     default:
