diff --git a/dlls/winex11.drv/init.c b/dlls/winex11.drv/init.c
index 09ef2bf..7a79342 100644
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -26,6 +26,7 @@
 
 #include <stdarg.h>
 #include <string.h>
+#include <strings.h>
 
 #include "windef.h"
 #include "winbase.h"
@@ -508,6 +509,66 @@ failed:
 /**********************************************************************
  *           ExtEscape  (X11DRV.@)
  */
+/* Whether the X window under the pointer belongs to Wine rather than to another application
+ * covering our windows, which the window tree of the server knows nothing about. Cached
+ * briefly, applications such as Unreal Engine ask on every frame. */
+static BOOL query_pointer_window( POINT *pos )
+{
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    static ULONG last_time;
+    static POINT last_pos;
+    static BOOL last_result;
+    Display *display = thread_init_display();
+    Window root, child, window;
+    int root_x, root_y, x, y, depth;
+    unsigned int state;
+    ULONG now = NtGetTickCount();
+    BOOL ret = FALSE, cached;
+
+    if (!XQueryPointer( display, root_window, &root, &child, &root_x, &root_y, &x, &y, &state ))
+        return TRUE;  /* pointer on another screen, we cannot tell */
+    *pos = root_to_virtual_screen( x, y );
+
+    pthread_mutex_lock( &lock );
+    if ((cached = now - last_time < 50 && pos->x == last_pos.x && pos->y == last_pos.y)) ret = last_result;
+    pthread_mutex_unlock( &lock );
+    if (cached) return ret;
+
+    /* walk down from the top-level window (usually a window manager frame) */
+    for (depth = 0; child && depth < 8; depth++)
+    {
+        XClassHint hint;
+        char *hwnd;
+
+        window = child;
+        if (!XFindContext( display, window, winContext, &hwnd ))
+        {
+            ret = TRUE;
+            break;
+        }
+        if (XGetClassHint( display, window, &hint ))
+        {
+            /* Wine names its windows after the process, also in other processes */
+            size_t len = hint.res_name ? strlen( hint.res_name ) : 0;
+            ret = len > 4 && !strcasecmp( hint.res_name + len - 4, ".exe" );
+            if (hint.res_name) XFree( hint.res_name );
+            if (hint.res_class) XFree( hint.res_class );
+            break;  /* the client window of an application */
+        }
+        if (!XQueryPointer( display, window, &root, &child, &root_x, &root_y, &x, &y, &state )) break;
+    }
+    /* no window under the pointer: either the root window, or under XWayland a Wayland surface */
+
+    TRACE( "pointer at %s over %s window %lx\n", wine_dbgstr_point( pos ), ret ? "a Wine" : "another", child );
+
+    pthread_mutex_lock( &lock );
+    last_time = now;
+    last_pos = *pos;
+    last_result = ret;
+    pthread_mutex_unlock( &lock );
+    return ret;
+}
+
 static INT X11DRV_ExtEscape( PHYSDEV dev, INT escape, INT in_count, LPCVOID in_data,
                              INT out_count, LPVOID out_data )
 {
@@ -555,6 +616,14 @@ static INT X11DRV_ExtEscape( PHYSDEV dev, INT escape, INT in_count, LPCVOID in_d
                     return TRUE;
                 }
                 break;
+            case X11DRV_QUERY_POINTER_WINDOW:
+                if (out_count >= sizeof(struct x11drv_escape_query_pointer_window))
+                {
+                    struct x11drv_escape_query_pointer_window *data = out_data;
+                    data->over_wine = query_pointer_window( &data->pos );
+                    return TRUE;
+                }
+                break;
             case X11DRV_START_EXPOSURES:
                 XSetGraphicsExposures( gdi_display, physDev->gc, True );
                 physDev->exposures = 0;
diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 2207378..cfa3009 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -618,7 +618,9 @@ static void sync_window_region( struct x11drv_win_data *data, HRGN win_region )
     HRGN hrgn = win_region;
 
     if (!data->whole_window) return;
-    if (client_side_graphics) return; /* use surface shape instead */
+    /* use the surface shape instead, unless a client window draws directly to the
+     * window: such windows have no surface and would lose their region */
+    if (client_side_graphics && !data->client_window) return;
     data->shaped = FALSE;
 
     if (hrgn == (HRGN)1)  /* hack: win_region == 1 means retrieve region from server */
@@ -936,7 +938,12 @@ static void set_size_hints( struct x11drv_win_data *data, DWORD style )
         }
         else size_hints->win_gravity = NorthWestGravity;
 
-        if (!is_window_resizable( data, style ))
+        /* Popups without a caption (menus, tooltips, drop-downs) have no frame to be resized
+         * with, so there is no point in fixing their size. Doing so makes window managers
+         * such as KWin clamp our own resize requests to the previous size when the requests
+         * race with the size hints update, and such popups then never grow. */
+        if (!is_window_resizable( data, style ) &&
+            !((style & WS_POPUP) && (style & WS_CAPTION) != WS_CAPTION))
         {
             size_hints->max_width = data->rects.visible.right - data->rects.visible.left;
             size_hints->max_height = data->rects.visible.bottom - data->rects.visible.top;
@@ -2298,6 +2305,11 @@ void detach_client_window( struct x11drv_win_data *data, Window client_window )
     {
         client_window_events_disable( data, client_window );
         XReparentWindow( gdi_display, client_window, get_dummy_parent(), 0, 0 );
+#ifdef HAVE_LIBXSHAPE
+        /* the window surface takes over the shape again */
+        if (client_side_graphics && data->shaped)
+            XShapeCombineMask( data->display, data->whole_window, ShapeBounding, 0, 0, None, ShapeSet );
+#endif
     }
 
     data->client_window = 0;
@@ -2323,6 +2335,8 @@ void attach_client_window( struct x11drv_win_data *data, Window client_window )
     }
 
     data->client_window = client_window;
+    /* the window draws directly now, apply its region ourselves (see sync_window_region) */
+    if (client_side_graphics && data->whole_window) sync_window_region( data, (HRGN)1 );
 }
 
 
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 8b0c0a6..3a966eb 100644
